{% doc %}
  Renders the side menu drawer for the header: promo card, menu links with dropdowns,
  social links and a bottom button. Uses the header section's settings.

  @example
  {% render 'header-drawer' %}
{% enddoc %}

<div class="eh-drawer__overlay" data-drawer-close></div>
<div
  id="HeaderDrawer-{{ section.id }}"
  class="eh-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'sections.header.menu' | t }}"
>
  <div class="eh-drawer__content">
    {%- if section.settings.show_promo -%}
      <div class="eh-promo">
        <div class="eh-promo__text">
          {%- if section.settings.promo_subheading != blank -%}
            <p class="eh-promo__subheading">{{ section.settings.promo_subheading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.promo_heading != blank -%}
            <p class="eh-promo__heading">{{ section.settings.promo_heading | escape }}</p>
          {%- endif -%}
          {%- if section.settings.promo_button_label != blank -%}
            <a
              href="{{ section.settings.promo_button_link | default: routes.all_products_collection_url }}"
              class="eh__button eh-promo__button"
            >
              {{ section.settings.promo_button_label | escape }}
              <svg class="eh__chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true">
                <path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.promo_image != blank -%}
          {{
            section.settings.promo_image
            | image_url: width: 800
            | image_tag: class: 'eh-promo__image', loading: 'lazy', sizes: '(min-width: 750px) 280px, 50vw'
          }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <nav class="eh-nav">
      <ul class="eh-nav__list" role="list">
        {%- for link in section.settings.menu.links -%}
          <li class="eh-nav__item">
            {%- if link.links != blank -%}
              <details class="eh-nav__details">
                <summary class="eh-nav__link">
                  {{ link.title | escape }}
                  <svg class="eh-nav__caret" viewBox="0 0 16 10" fill="none" aria-hidden="true">
                    <path d="M1 1.5l7 7 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </summary>
                <ul class="eh-nav__sublist" role="list">
                  {%- for childlink in link.links -%}
                    <li>
                      <a
                        href="{{ childlink.url }}"
                        class="eh-nav__sublink"
                        {% if childlink.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{- childlink.title | escape -}}
                      </a>
                      {%- if childlink.links != blank -%}
                        <ul class="eh-nav__sublist eh-nav__sublist--nested" role="list">
                          {%- for grandchildlink in childlink.links -%}
                            <li>
                              <a href="{{ grandchildlink.url }}" class="eh-nav__sublink">
                                {{- grandchildlink.title | escape -}}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="eh-nav__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="eh-drawer__footer">
      <ul class="eh-social" role="list">
        {%- assign social_networks = 'facebook,instagram,tiktok,twitter,pinterest,youtube,snapchat,tumblr,vimeo' | split: ',' -%}
        {%- for network in social_networks -%}
          {%- assign setting_key = 'social_' | append: network | append: '_link' -%}
          {%- if settings[setting_key] != blank -%}
            {%- assign icon = 'icon-' | append: network | append: '.svg' -%}
            {%- assign label_key = 'general.social.links.' | append: network -%}
            <li>
              <a href="{{ settings[setting_key] }}" class="eh-social__link" target="_blank" rel="noopener">
                {{- icon | inline_asset_content -}}
                <span class="visually-hidden">{{ label_key | t }}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.drawer_button_label != blank -%}
        <a href="{{ section.settings.drawer_button_link | default: routes.account_url }}" class="eh-drawer__outline-button">
          {{- section.settings.drawer_button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
