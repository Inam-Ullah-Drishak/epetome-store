{%- comment -%}
  Fallback line icons used by the Icon grid section when a block has no image.
  Accepts: name - one of mind, skin, immunity, digestion, hormones, leaf.
{%- endcomment -%}

{%- case name -%}
  {%- when 'mind' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M15 4a4 4 0 0 1 4 4 3.2 3.2 0 0 1 1 5.6V16a3 3 0 0 1-3 3h-1v1.5M9 4a4 4 0 0 0-4 4 3.2 3.2 0 0 0-1 5.6V16a3 3 0 0 0 3 3h1v1.5" />
      <path d="M12 4v16.5M9.5 9h5M9.5 14h5" />
    </svg>
  {%- when 'skin' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="8.5" />
      <path d="M8.5 10.5h.01M15.5 10.5h.01M11 14h.01M14 15.5h.01M9.5 16h.01" />
    </svg>
  {%- when 'immunity' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3 5 6v5.5c0 4.2 2.9 7.6 7 9.5 4.1-1.9 7-5.3 7-9.5V6l-7-3Z" />
      <path d="m9.2 12 2 2 3.6-3.8" />
    </svg>
  {%- when 'digestion' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M8 3v4.5a4.5 4.5 0 0 0 4.5 4.5 3.5 3.5 0 0 1 0 7H11" />
      <path d="M16 3v3a3 3 0 0 1-3 3" />
      <path d="M8.5 19H8a2.5 2.5 0 0 1 0-5h1" />
    </svg>
  {%- when 'hormones' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M7 4c0 4 10 12 10 16M17 4c0 4-10 12-10 16" />
      <path d="M8.8 8h6.4M8.8 16h6.4" />
    </svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 20c0-6 3-10 8-11 0 7-3.5 11-8 11Z" />
      <path d="M12 20c0-4.5-2.2-7.5-6-8.4 0 5.2 2.6 8.4 6 8.4Z" />
      <path d="M12 20v-3" />
    </svg>
{%- endcase -%}
