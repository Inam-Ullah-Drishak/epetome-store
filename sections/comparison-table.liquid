{{ 'section-comparison-table.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ComparisonTable-{{ section.id }} {
    --ct-highlight-bg: {{ section.settings.highlight_bg }};
    --ct-highlight-text: {{ section.settings.highlight_text }};
    --ct-row-bg: {% if section.settings.row_bg != blank %}{{ section.settings.row_bg }}{% else %}transparent{% endif %};
    --ct-border: {% if section.settings.border_color != blank %}{{ section.settings.border_color }}{% else %}rgb(var(--color-foreground)){% endif %};
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #ComparisonTable-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns = section.settings.column_count | default: 3
  assign highlight = section.settings.highlight_column | default: 1
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="ComparisonTable-{{ section.id }}"
    class="comparison-table page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="comparison-table__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="comparison-table__heading inline-richtext {{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="comparison-table__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="comparison-table__scroller">
      <table class="comparison-table__table">
        <caption class="visually-hidden">{{ section.settings.heading | strip_html | escape }}</caption>
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Feature</span></th>
            {%- for i in (1..columns) -%}
              {%- liquid
                case i
                  when 1
                    assign col_heading = section.settings.column_1_heading
                  when 2
                    assign col_heading = section.settings.column_2_heading
                  else
                    assign col_heading = section.settings.column_3_heading
                endcase
              -%}
              <th
                scope="col"
                class="comparison-table__col-head{% if i == highlight %} comparison-table__col--highlight{% endif %}"
              >
                {{- col_heading | escape -}}
              </th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr class="comparison-table__row" {{ block.shopify_attributes }}>
              <th scope="row" class="comparison-table__label">
                <span class="comparison-table__label-text">{{ block.settings.label | escape }}</span>
                {%- if block.settings.caption != blank -%}
                  <span class="comparison-table__label-caption">{{ block.settings.caption | escape }}</span>
                {%- endif -%}
              </th>

              {%- for i in (1..columns) -%}
                {%- liquid
                  case i
                    when 1
                      assign cell_type = block.settings.column_1_type
                      assign cell_value = block.settings.column_1_value
                      assign cell_caption = block.settings.column_1_caption
                    when 2
                      assign cell_type = block.settings.column_2_type
                      assign cell_value = block.settings.column_2_value
                      assign cell_caption = block.settings.column_2_caption
                    else
                      assign cell_type = block.settings.column_3_type
                      assign cell_value = block.settings.column_3_value
                      assign cell_caption = block.settings.column_3_caption
                  endcase
                -%}
                <td class="comparison-table__cell{% if i == highlight %} comparison-table__col--highlight{% endif %}">
                  {%- case cell_type -%}
                    {%- when 'yes' -%}
                      <span class="comparison-table__icon comparison-table__icon--yes" role="img" aria-label="Included">
                        <svg viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
                          <path fill="currentColor" d="M13.7484 2.42918C16.851 2.42918 19.8266 3.66171 22.0205 5.85562C24.2144 8.04953 25.447 11.0251 25.447 14.1278C25.447 17.2304 24.2144 20.206 22.0205 22.3999C19.8266 24.5938 16.851 25.8264 13.7484 25.8264C10.6457 25.8264 7.67012 24.5938 5.47621 22.3999C3.2823 20.206 2.04977 17.2304 2.04977 14.1278C2.04977 11.0251 3.2823 8.04953 5.47621 5.85562C7.67012 3.66171 10.6457 2.42918 13.7484 2.42918ZM13.7484 27.4976C17.2943 27.4976 20.6949 26.089 23.2023 23.5817C25.7096 21.0743 27.1182 17.6737 27.1182 14.1278C27.1182 10.5819 25.7096 7.18121 23.2023 4.67388C20.6949 2.16655 17.2943 0.75795 13.7484 0.75795C10.2025 0.75795 6.8018 2.16655 4.29447 4.67388C1.78714 7.18121 0.37854 10.5819 0.37854 14.1278C0.37854 17.6737 1.78714 21.0743 4.29447 23.5817C6.8018 26.089 10.2025 27.4976 13.7484 27.4976ZM19.3522 11.3755C19.676 11.0517 19.676 10.519 19.3522 10.1952C19.0284 9.87137 18.4957 9.87137 18.1719 10.1952L12.0771 16.2899L9.32483 13.5376C9.00103 13.2138 8.46833 13.2138 8.14453 13.5376C7.82073 13.8614 7.82073 14.3941 8.14453 14.7179L11.487 18.0604C11.8108 18.3842 12.3435 18.3842 12.6673 18.0604L19.3522 11.3755Z" />
                        </svg>
                      </span>
                    {%- when 'no' -%}
                      <span class="comparison-table__icon comparison-table__icon--no" role="img" aria-label="Not included">
                        <svg viewBox="0 0 28 28" fill="none" aria-hidden="true" focusable="false">
                          <path fill="currentColor" d="M14.1425 2.42918C17.2452 2.42918 20.2208 3.66171 22.4147 5.85562C24.6086 8.04953 25.8411 11.0251 25.8411 14.1278C25.8411 17.2304 24.6086 20.206 22.4147 22.3999C20.2208 24.5938 17.2452 25.8264 14.1425 25.8264C11.0399 25.8264 8.06428 24.5938 5.87037 22.3999C3.67646 20.206 2.44393 17.2304 2.44393 14.1278C2.44393 11.0251 3.67646 8.04953 5.87037 5.85562C8.06428 3.66171 11.0399 2.42918 14.1425 2.42918ZM14.1425 27.4976C17.6884 27.4976 21.0891 26.089 23.5964 23.5817C26.1038 21.0743 27.5124 17.6737 27.5124 14.1278C27.5124 10.5819 26.1038 7.18121 23.5964 4.67388C21.0891 2.16655 17.6884 0.75795 14.1425 0.75795C10.5966 0.75795 7.19596 2.16655 4.68864 4.67388C2.18131 7.18121 0.772705 10.5819 0.772705 14.1278C0.772705 17.6737 2.18131 21.0743 4.68864 23.5817C7.19596 26.089 10.5966 27.4976 14.1425 27.4976ZM10.2099 10.1952C9.88612 10.519 9.88612 11.0517 10.2099 11.3755L12.9622 14.1278L10.2099 16.8801C9.88612 17.2039 9.88612 17.7366 10.2099 18.0604C10.5337 18.3842 11.0664 18.3842 11.3902 18.0604L14.1425 15.3081L16.8948 18.0604C17.2186 18.3842 17.7513 18.3842 18.0751 18.0604C18.3989 17.7366 18.3989 17.2039 18.0751 16.8801L15.3228 14.1278L18.0751 11.3755C18.3989 11.0517 18.3989 10.519 18.0751 10.1952C17.7513 9.87137 17.2186 9.87137 16.8948 10.1952L14.1425 12.9475L11.3902 10.1952C11.0664 9.87137 10.5337 9.87137 10.2099 10.1952Z" />
                        </svg>
                      </span>
                    {%- else -%}
                      {%- if cell_value != blank -%}
                        <span class="comparison-table__value">{{ cell_value | escape }}</span>
                      {%- endif -%}
                  {%- endcase -%}

                  {%- if cell_caption != blank -%}
                    <span class="comparison-table__cell-caption">{{ cell_caption | escape }}</span>
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.footnote != blank -%}
      <div class="comparison-table__footnote rte">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "what sets epetōme apart?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "pre + pro + synbiotic dual cap."
    },
    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "column_count",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Number of comparison columns",
      "default": 3
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Column 1 heading",
      "default": "epetōme."
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Column 2 heading",
      "default": "non-encapsulated"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Column 3 heading",
      "default": "standard capsules"
    },
    {
      "type": "range",
      "id": "highlight_column",
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "Highlighted column",
      "info": "0 highlights none.",
      "default": 1
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Text below table",
      "default": "<p>Epetōme looks different, and for good reason. Just one potent daily dose of biotics with advanced synbiotic dual cap technology, to ensure each ingredient is delivered with precision - to the right place, at the right time.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Highlighted column background",
      "default": "#1f4d3a"
    },
    {
      "type": "color",
      "id": "highlight_text",
      "label": "Highlighted column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "row_bg",
      "label": "Table background",
      "info": "Leave empty for no fill behind the ordinary columns.",
      "default": ""
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Table rules",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "potency."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Row caption",
          "info": "Small text under the label."
        },
        {
          "type": "header",
          "content": "Column 1"
        },
        {
          "type": "select",
          "id": "column_1_type",
          "label": "Cell type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "yes", "label": "Tick" },
            { "value": "no", "label": "Dash" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "column_1_value", "label": "Value", "info": "Used when the cell type is Text." },
        { "type": "text", "id": "column_1_caption", "label": "Caption" },
        {
          "type": "header",
          "content": "Column 2"
        },
        {
          "type": "select",
          "id": "column_2_type",
          "label": "Cell type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "yes", "label": "Tick" },
            { "value": "no", "label": "Dash" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "column_2_value", "label": "Value", "info": "Used when the cell type is Text." },
        { "type": "text", "id": "column_2_caption", "label": "Caption" },
        {
          "type": "header",
          "content": "Column 3"
        },
        {
          "type": "select",
          "id": "column_3_type",
          "label": "Cell type",
          "options": [
            { "value": "text", "label": "Text" },
            { "value": "yes", "label": "Tick" },
            { "value": "no", "label": "Dash" }
          ],
          "default": "text"
        },
        { "type": "text", "id": "column_3_value", "label": "Value", "info": "Used when the cell type is Text." },
        { "type": "text", "id": "column_3_caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comparison table",
      "settings": { "color_scheme": "scheme-1" },
      "blocks": [
        { "type": "row", "settings": { "label": "potency.", "caption": "CFU/g (billion)", "column_1_type": "text", "column_1_value": "50", "column_2_type": "text", "column_2_value": "10", "column_3_type": "text", "column_3_value": "10-20" } },
        { "type": "row", "settings": { "label": "synbiotic dual cap technology.", "column_1_type": "yes", "column_2_type": "no", "column_3_type": "no" } },
        { "type": "row", "settings": { "label": "diversity.", "caption": "number of bacterial strains", "column_1_type": "text", "column_1_value": "11", "column_2_type": "text", "column_2_value": "4", "column_3_type": "text", "column_3_value": "7-14" } },
        { "type": "row", "settings": { "label": "prebiotic included.", "column_1_type": "yes", "column_2_type": "no", "column_3_type": "no" } },
        { "type": "row", "settings": { "label": "vitamins & minerals included.", "column_1_type": "yes", "column_2_type": "no", "column_3_type": "no" } },
        { "type": "row", "settings": { "label": "convenient storage.", "column_1_type": "text", "column_1_value": "yes", "column_1_caption": "cupboard", "column_2_type": "text", "column_2_value": "no", "column_2_caption": "refrigerated", "column_3_type": "text", "column_3_value": "yes", "column_3_caption": "cupboard" } },
        { "type": "row", "settings": { "label": "convenient consumption.", "column_1_type": "text", "column_1_value": "yes", "column_1_caption": "1 a day", "column_2_type": "text", "column_2_value": "yes", "column_2_caption": "70ml a day", "column_3_type": "text", "column_3_value": "no", "column_3_caption": "3+ per day" } },
        { "type": "row", "settings": { "label": "price per serving.", "caption": "starting from prices", "column_1_type": "text", "column_1_value": "£1.33", "column_2_type": "text", "column_2_value": "£1.43", "column_3_type": "text", "column_3_value": "£1.33" } }
      ]
    }
  ]
}
{% endschema %}
