{{ 'section-header.css' | asset_url | stylesheet_tag }}
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign transparent = false
  if section.settings.transparent_mode == 'all'
    assign transparent = true
  elsif section.settings.transparent_mode == 'home' and request.page_type == 'index'
    assign transparent = true
  endif

  assign logo_solid = section.settings.logo_solid | default: section.settings.logo_transparent | default: settings.logo
  assign logo_transparent = section.settings.logo_transparent | default: logo_solid
  assign overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --eh-bar-padding-y: {{ section.settings.padding_y | times: 0.6 | round: 0 }}px;
    --eh-logo-width: {{ section.settings.logo_width_mobile }}px;
    --eh-solid-bg: {{ section.settings.solid_bg }};
    --eh-solid-text: {{ section.settings.solid_text }};
    --eh-solid-button-bg: {{ section.settings.solid_button_bg }};
    --eh-solid-button-text: {{ section.settings.solid_button_text }};
    --eh-transparent-text: {{ section.settings.transparent_text }};
    --eh-drawer-bg: {{ section.settings.drawer_bg }};
    --eh-drawer-text: {{ section.settings.drawer_text }};
    --eh-promo-bg: {{ section.settings.promo_bg }};
    --eh-overlay: {{ section.settings.overlay_color | color_modify: 'alpha', overlay_alpha }};
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} {
      --eh-bar-padding-y: {{ section.settings.padding_y }}px;
      --eh-logo-width: {{ section.settings.logo_width }}px;
    }
  }
{%- endstyle -%}

<sticky-header
  class="eh{% if transparent %} eh--transparent{% endif %}{% if section.settings.sticky %} eh--sticky{% endif %}{% if section.settings.show_border %} eh--border{% endif %}"
  data-sticky-type="{% if section.settings.sticky %}always{% else %}none{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="eh__bar">
    <header class="eh__inner page-width">
      <div class="eh__left">
        {%- if section.settings.menu != blank -%}
          <button
            type="button"
            class="eh__menu-toggle"
            aria-expanded="false"
            aria-controls="HeaderDrawer-{{ section.id }}"
            aria-label="{{ 'sections.header.menu' | t }}"
          >
            <span class="eh__menu-icon" aria-hidden="true">
              <svg class="eh__icon-open" viewBox="0 0 28 10" fill="none">
                <path d="M1 1h26M1 9h26" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
              <svg class="eh__icon-close" viewBox="0 0 24 24" fill="none">
                <path d="M3 3l18 18M21 3L3 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </span>
            {%- if section.settings.menu_label != blank -%}
              <span class="eh__menu-label">{{ section.settings.menu_label | escape }}</span>
            {%- endif -%}
          </button>
        {%- endif -%}
      </div>

      {%- if request.page_type == 'index' -%}
        <h1 class="eh__heading">
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="eh__logo">
        {%- if logo_solid != blank -%}
          {%- capture sizes %}(min-width: 990px) {{ section.settings.logo_width }}px, {{ section.settings.logo_width_mobile }}px{% endcapture -%}
          {%- capture widths %}{{ section.settings.logo_width }}, {{ section.settings.logo_width | times: 1.5 | round }}, {{ section.settings.logo_width | times: 2 }}{% endcapture -%}
          {{
            logo_transparent
            | image_url: width: 800
            | image_tag:
              class: 'eh__logo-img eh__logo-img--transparent',
              widths: widths,
              sizes: sizes,
              alt: shop.name,
              preload: true
          }}
          {{
            logo_solid
            | image_url: width: 800
            | image_tag:
              class: 'eh__logo-img eh__logo-img--solid',
              widths: widths,
              sizes: sizes,
              alt: shop.name,
              loading: 'eager'
          }}
        {%- else -%}
          <span class="eh__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}

      <div class="eh__right">
        {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
          <shopify-account
            menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
            class="eh__icon eh__account"
          >
            <span slot="signed-out-avatar" class="eh__svg">{{ 'icon-account.svg' | inline_asset_content }}</span>
            <span slot="signed-out-avatar" class="visually-hidden">{{ 'customer.log_in' | t }}</span>
          </shopify-account>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <a
          href="{{ routes.cart_url }}"
          class="eh__icon eh__cart"
          id="cart-icon-bubble"
          {% unless section.settings.show_cart %}
            hidden
          {% endunless %}
        >
          {%- if cart == empty -%}
            <span class="eh__svg">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
          {%- else -%}
            <span class="eh__svg">{{ 'icon-cart.svg' | inline_asset_content }}</span>
          {%- endif -%}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="eh__button{% if section.settings.transparent_button_filled %} eh__button--filled-transparent{% endif %}"
          >
            {{ section.settings.button_label | escape }}
            <svg class="eh__chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true">
              <path d="M1 1l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    </header>
  </div>

  {%- if section.settings.menu != blank -%}
    {%- render 'header-drawer' -%}
  {%- endif -%}
</sticky-header>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.popup_color_scheme, desktop_menu_type: 'drawer' -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
      this.onScroll = this.onScroll.bind(this);
      this.onResize = this.onResize.bind(this);
      this.onKeyUp = this.onKeyUp.bind(this);
      this.onSectionSelect = this.onSectionSelect.bind(this);
      this.onSectionDeselect = this.onSectionDeselect.bind(this);
    }

    connectedCallback() {
      this.bar = this.querySelector('.eh__bar');
      this.toggle = this.querySelector('.eh__menu-toggle');
      this.drawer = this.querySelector('.eh-drawer');
      this.isTransparent = this.classList.contains('eh--transparent');

      this.toggle?.addEventListener('click', () => (this.isOpen() ? this.close() : this.open()));
      this.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', () => this.close()));

      window.addEventListener('scroll', this.onScroll, { passive: true });
      window.addEventListener('resize', this.onResize);
      document.addEventListener('shopify:section:select', this.onSectionSelect);
      document.addEventListener('shopify:section:deselect', this.onSectionDeselect);

      this.updateSolidState();
      this.onResize();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScroll);
      window.removeEventListener('resize', this.onResize);
      document.removeEventListener('keyup', this.onKeyUp);
      document.removeEventListener('shopify:section:select', this.onSectionSelect);
      document.removeEventListener('shopify:section:deselect', this.onSectionDeselect);
      document.body.classList.remove('overflow-hidden');
    }

    isOpen() {
      return this.classList.contains('eh--open');
    }

    open() {
      if (!this.drawer) return;
      this.updateDrawerTop();
      this.classList.add('eh--open');
      this.toggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('overflow-hidden');
      document.addEventListener('keyup', this.onKeyUp);
      this.updateSolidState();
      this.drawer.querySelector('a, summary, button')?.focus({ preventScroll: true });
    }

    close() {
      if (!this.isOpen()) return;
      this.classList.remove('eh--open');
      this.toggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('overflow-hidden');
      document.removeEventListener('keyup', this.onKeyUp);
      this.updateSolidState();
      this.toggle.focus({ preventScroll: true });
    }

    // Kept for other theme scripts (e.g. cart-notification.js) that call these on the header.
    reveal() {}
    hide() {}

    onKeyUp(event) {
      if (event.code === 'Escape') this.close();
    }

    onScroll() {
      if (this.ticking) return;
      this.ticking = true;
      requestAnimationFrame(() => {
        this.updateSolidState();
        if (this.isOpen()) this.updateDrawerTop();
        this.ticking = false;
      });
    }

    onResize() {
      document.documentElement.style.setProperty('--header-height', `${this.bar.offsetHeight}px`);
      if (this.isOpen()) this.updateDrawerTop();
    }

    // The header gets its background once the page is scrolled or the menu is open.
    updateSolidState() {
      if (!this.isTransparent) return;
      this.classList.toggle('eh--solid', window.scrollY > 10 || this.isOpen());
    }

    updateDrawerTop() {
      const bottom = Math.max(0, Math.round(this.bar.getBoundingClientRect().bottom));
      this.style.setProperty('--eh-drawer-top', `${bottom}px`);
    }

    onSectionSelect(event) {
      if (event.detail.sectionId === this.dataset.sectionId) this.open();
    }

    onSectionDeselect(event) {
      if (event.detail.sectionId === this.dataset.sectionId) this.close();
    }
  }

  // The account `open` event is composed but does not bubble, so listen during capture.
  // Anchor the dialog to the bottom of the account button itself.
  document.addEventListener(
    'open',
    (event) => {
      if (!(event.target instanceof HTMLElement) || !event.target.matches('shopify-account')) return;

      const bottom = Math.max(0, Math.round(event.target.getBoundingClientRect().bottom));
      event.target.style.setProperty('--account-dialog-top', `${bottom}px`);
    },
    true
  );

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if logo_solid %}
      "logo": {{ logo_solid | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "image_picker",
      "id": "logo_transparent",
      "label": "Logo on transparent header",
      "info": "Shown while the header sits over the page, before scrolling. Usually a light/white logo."
    },
    {
      "type": "image_picker",
      "id": "logo_solid",
      "label": "Logo on header with background",
      "info": "Shown after scrolling or when the menu is open. Usually a dark logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 400,
      "step": 5,
      "unit": "px",
      "label": "Logo width (desktop)",
      "default": 220
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "min": 50,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Logo width (mobile)",
      "default": 120
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "select",
      "id": "transparent_mode",
      "label": "Transparent header",
      "options": [
        { "value": "none", "label": "Never" },
        { "value": "home", "label": "Home page only" },
        { "value": "all", "label": "All pages" }
      ],
      "default": "home",
      "info": "The header overlays the first section and gets a background once you scroll."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border when header has background",
      "default": false
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label",
      "info": "Links with sub-links open as dropdowns inside the side menu."
    },
    {
      "type": "text",
      "id": "menu_label",
      "label": "Menu button text",
      "default": "menu"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "transparent_button_filled",
      "label": "Show button background on transparent header",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors: transparent header"
    },
    {
      "type": "color",
      "id": "transparent_text",
      "label": "Text and icons",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Colors: header with background"
    },
    {
      "type": "color",
      "id": "solid_bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "solid_text",
      "label": "Text and icons",
      "default": "#193A24"
    },
    {
      "type": "color",
      "id": "solid_button_bg",
      "label": "Button background",
      "default": "#193A24"
    },
    {
      "type": "color",
      "id": "solid_button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color_scheme",
      "id": "popup_color_scheme",
      "label": "Cart popup color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Side menu"
    },
    {
      "type": "color",
      "id": "drawer_bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "drawer_text",
      "label": "Text",
      "default": "#193A24"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Page overlay color",
      "default": "#193A24"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Page overlay opacity",
      "default": 45
    },
    {
      "type": "text",
      "id": "drawer_button_label",
      "label": "Bottom button text",
      "default": "Manage subscription"
    },
    {
      "type": "url",
      "id": "drawer_button_link",
      "label": "Bottom button link"
    },
    {
      "type": "paragraph",
      "content": "Social icons come from Theme settings > Social media."
    },
    {
      "type": "header",
      "content": "Side menu promo card"
    },
    {
      "type": "checkbox",
      "id": "show_promo",
      "label": "Show promo card",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_subheading",
      "label": "Subheading",
      "default": "synbiotic dual cap."
    },
    {
      "type": "text",
      "id": "promo_heading",
      "label": "Heading",
      "default": "meet your new gut health routine."
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "promo_button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "promo_image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "promo_bg",
      "label": "Card background",
      "default": "#F1F0EC"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Top and bottom padding",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
