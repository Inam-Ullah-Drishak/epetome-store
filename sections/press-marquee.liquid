{{ 'section-press-marquee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #PressMarquee-{{ section.id }} {
    --pm-bg: {{ section.settings.background_color }};
    --pm-heading-color: {{ section.settings.heading_color }};
    --pm-text-color: {{ section.settings.text_color }};
    --pm-duration: {{ section.settings.speed }}s;
    --pm-padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --pm-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    --pm-gap: {{ section.settings.item_gap_mobile }}px;
    --pm-item-width: {{ section.settings.item_width_mobile }}px;
    --pm-logo-height: {{ section.settings.logo_height_mobile }}px;
    --pm-separator-height: {{ section.settings.separator_height_mobile }}px;
    --pm-heading-size: {{ section.settings.heading_size | times: 0.85 | round: 0 }}px;
    --pm-text-size: {{ section.settings.text_size | times: 0.9 | round: 0 }}px;
    --pm-heading-weight: {{ section.settings.heading_weight }};
    --pm-content-spacing: {{ section.settings.content_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    #PressMarquee-{{ section.id }} {
      --pm-padding-top: {{ section.settings.padding_top }}px;
      --pm-padding-bottom: {{ section.settings.padding_bottom }}px;
      --pm-gap: {{ section.settings.item_gap }}px;
      --pm-item-width: {{ section.settings.item_width }}px;
      --pm-logo-height: {{ section.settings.logo_height }}px;
      --pm-separator-height: {{ section.settings.separator_height }}px;
      --pm-heading-size: {{ section.settings.heading_size }}px;
      --pm-text-size: {{ section.settings.text_size }}px;
    }
  }
{%- endstyle -%}

{%- capture separator -%}
  {%- if section.settings.separator_image != blank -%}
    <div class="press-marquee__separator">
      {{
        section.settings.separator_image
        | image_url: width: 400
        | image_tag: loading: 'lazy', alt: '', sizes: '200px', widths: '100, 200, 400'
      }}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div
  id="PressMarquee-{{ section.id }}"
  class="press-marquee press-marquee--align-{{ section.settings.text_alignment }} press-marquee--valign-{{ section.settings.vertical_alignment }}{% if section.settings.pause_on_hover %} press-marquee--pause-hover{% endif %}{% if section.settings.direction == 'right' %} press-marquee--reverse{% endif %}"
>
  <div class="press-marquee__track">
    {%- for i in (1..2) -%}
      <div class="press-marquee__group"{% if forloop.last %} aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <div class="press-marquee__item" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
            {%- if block.settings.link != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="press-marquee__link"
                {% if forloop.parentloop.last %}
                  tabindex="-1"
                {% endif %}
              >
            {%- endif -%}

            {%- if block.settings.logo != blank -%}
              {%- assign logo_alt = block.settings.logo.alt | default: block.settings.heading | strip_html | escape -%}
              <div class="press-marquee__logo">
                {{
                  block.settings.logo
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    alt: logo_alt,
                    sizes: '300px',
                    widths: '150, 300, 600'
                }}
              </div>
            {%- elsif request.design_mode -%}
              <div class="press-marquee__logo press-marquee__logo--placeholder">
                {{ 'logo' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <p class="press-marquee__heading">{{ block.settings.heading }}</p>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="press-marquee__text">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
        {{ separator }}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Press marquee",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Separator image"
    },
    {
      "type": "image_picker",
      "id": "separator_image",
      "label": "Image",
      "info": "Shown before and after each group of items."
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 20,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Height (desktop)",
      "default": 130
    },
    {
      "type": "range",
      "id": "separator_height_mobile",
      "min": 20,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Height (mobile)",
      "default": 90
    },
    {
      "type": "header",
      "content": "Items"
    },
    {
      "type": "range",
      "id": "item_width",
      "min": 150,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Item width (desktop)",
      "default": 280
    },
    {
      "type": "range",
      "id": "item_width_mobile",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Item width (mobile)",
      "default": 220
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Space between items (desktop)",
      "default": 70
    },
    {
      "type": "range",
      "id": "item_gap_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space between items (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 20,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Logo height (desktop)",
      "default": 50
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo height (mobile)",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_spacing",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between logo, heading and text",
      "default": 14
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "end", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 20
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 11,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 17
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBFBF8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#193A24"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#4A4A4A"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Duration of one loop",
      "info": "Higher is slower.",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>“Add a short quote or description here.”</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press marquee",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
