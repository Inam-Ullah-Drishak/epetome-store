{{ 'section-community-feed.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #CommunityFeed-{{ section.id }} {
    --cf-columns: {{ section.settings.columns_mobile }};
    --cf-gap: {{ section.settings.gap }}px;
    --cf-radius: {{ section.settings.image_radius }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #CommunityFeed-{{ section.id }} {
      --cf-columns: {{ section.settings.columns }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="CommunityFeed-{{ section.id }}"
    class="community-feed{% unless section.settings.full_width %} page-width{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    {%- if section.settings.heading != blank or section.settings.handle != blank -%}
      <div class="community-feed__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="community-feed__heading inline-richtext {{ section.settings.heading_size }}">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.handle != blank -%}
          {%- if section.settings.handle_link != blank -%}
            <a href="{{ section.settings.handle_link }}" class="community-feed__handle">
              {{- section.settings.handle | escape -}}
            </a>
          {%- else -%}
            <p class="community-feed__handle">{{ section.settings.handle | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="community-feed__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign alt = block.settings.alt | default: section.settings.handle
            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
          -%}
          <li class="community-feed__item" {{ block.shopify_attributes }}>
            {%- if has_link -%}<a href="{{ block.settings.link }}" class="community-feed__link">{%- endif -%}
              <div class="community-feed__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 600, 800, 1200',
                      sizes: '(min-width: 990px) 20vw, 45vw',
                      alt: alt
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
            {%- if has_link -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Community feed",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "join our community."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@epetome_co"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Handle link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Images per row (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Images per row (mobile)",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between images",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "limit": 16,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Describes the image for screen readers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
