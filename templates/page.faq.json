        "video_NTb97p": {
          "type": "video",
          "settings": {
            "question": "What exactly is Epetōme’s synbiotic dual cap?",
            "video_url": "",
            "cover_image": "shopify://shop_images/7eeee84a49b94f0f8121ca7e1c4f9e42.thumbnail.0000000000_1000x_2b66e856-201c-4187-95db-648635bba08f.jpg",
